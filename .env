# Domains
LMS_DOMAIN=localhost
SPA_DOMAIN=app.localhost
LOGTO_AUTH_DOMAIN=auth.localhost
AUTH_DOMAIN=sign-in.localhost
ADMIN_DOMAIN=admin.localhost
KAFKA_DOMAIN=kafka.localhost

# REDIS configs
REDIS_CONNECTION_URL="redis://host.docker.internal:6379"

# Nginx configs
MAIN_NGINX_PORT=80

# OAuth2-Proxy configs
OAUTH2_PROXY_PORT=4180

# PostgreSQL configs
DATABASE_PORT=5432
DATABASE_NAME=lms
DATABASE_SCHEMA=lms_schema

#DATABASE_URL="jdbc:postgresql://localhost:${DATABASE_PORT}/${DATABASE_NAME}"
DATABASE_URL="jdbc:postgresql://postgres:5432/${DATABASE_NAME}"

DATABASE_USERNAME=root
DATABASE_PASSWORD=toor

# LogTo base configs
LOGTO_DATABASE_NAME=logto
LOGTO_DATABASE_URL="postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@postgres:5432/${LOGTO_DATABASE_NAME}"

# KAFKA
KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_HOST_NAME_1=localhost
KAFKA_PORT_1=9092
