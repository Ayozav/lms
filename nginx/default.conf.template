# ./nginx/default.conf.template

# 1. Основной сервер для LMS
server {
    listen 80;
    server_name ${LMS_DOMAIN};

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://students-service:4040/;
    }

    root /usr/share/nginx/html;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 2. Поддомен для авторизации пользователей
server {
    listen 80;
    server_name ${AUTH_DOMAIN};

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://logto:3001;
    }
}

# 3. Поддомен для админки LogTo
server {
    listen 80;
    server_name ${ADMIN_DOMAIN};

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://logto:3002;
    }
}

