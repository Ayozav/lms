server {
    # ЗДЕСЬ У НАС РАБОЧИЙ ТОВАРИЩ-ГОСПОДИН С авторизацией.
    # Мы доверяем пришедшим запросам.
    listen ${MAIN_NGINX_PORT};
    server_name ${LMS_DOMAIN};

    # Корневая страница (пример)
    location / {
        add_header Content-Type text/html;
        return 200 "HIIIIIIIII, WORLD!!!";
    }

    location /api/ {
        add_header Content-Type text/html;
        return 200 "HIIIIIIIII, API!!!";    
    }
}